VITE_API_URL=http://localhost:3000
# Optional, dev only (`bun run dev`): enables the "Demo accounts" switcher on the sign-in page.
# Put real values in .env.development.local (git-ignored) so they are never used by `vite build`.
# They must match the backend's SEED_ADMIN_PASSWORD / SEED_USER_PASSWORD.
VITE_DEMO_ADMIN_PASSWORD=
VITE_DEMO_USER_PASSWORD=
